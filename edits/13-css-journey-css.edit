/* ---------- Cycle card extras ---------- */
.hero { cursor: pointer; }
.hero .legend { flex-wrap: wrap; row-gap: 6px; }
.jnext.quiet { background: rgba(255, 255, 255, .72); color: var(--text); }
.jnext.quiet .nico { background: #fff; color: var(--ok); }
.jnext.quiet .t2 { color: var(--text-2); }

/* ---------- Calmer journey, option A: timeline ---------- */
.tl { margin-top: 28px; }
.tl-h, .ck-h { display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; }
.tl-h { padding: 0 4px 10px; border-bottom: 1px solid var(--border); }
.tl-h .k, .ck-h .k { display: block; font-size: 11.5px; letter-spacing: .08em; text-transform: uppercase; color: var(--text-3); font-weight: 600; line-height: 16px; }
.tl-h b, .ck-h b { display: block; font-size: 18px; line-height: 24px; font-weight: 600; letter-spacing: -.01em; }
.tl-h .cnt, .ck-h .cnt { font-size: 13px; color: var(--text-2); white-space: nowrap; line-height: 22px; }
.tl-rows { padding-top: 6px; }
.tl-row { display: flex; align-items: center; gap: 14px; width: 100%; text-align: left; padding: 10px 12px 10px 4px; position: relative; min-height: 58px; border-radius: 14px; }
.tl-row::before { content: ''; position: absolute; left: 14px; top: 0; bottom: 0; width: 2px; background: var(--border-strong); }
.tl-row:first-child::before { top: 50%; }
.tl-row:last-child::before { bottom: 50%; }
.tl-row.done::before { background: var(--sun-500); }
.tl-m { width: 22px; height: 22px; border-radius: 50%; flex: none; display: grid; place-items: center; position: relative; z-index: 1; background: var(--bg); border: 2px solid var(--border-strong); color: #4a3600; }
.tl-row.done .tl-m { background: var(--sun-500); border-color: var(--sun-500); }
.tl-row.open .tl-m { border-color: var(--ink); background: #fff; }
.tl-row.current .tl-m { border-color: var(--ink); background: var(--ink); box-shadow: 0 0 0 4px rgba(42, 42, 42, .1); }
.tl-row.call .tl-m { background: var(--sky-100); border-color: #9dbbdd; color: var(--sky-700); }
.tl-row.call.done .tl-m { background: var(--sun-500); border-color: var(--sun-500); color: #4a3600; }
.tl-row.ms .tl-m { width: 14px; height: 14px; margin: 0 4px; border-radius: 4px; transform: rotate(45deg); }
.tl-row.ms .tl-m .i { display: none; }
.tl-t { flex: 1; min-width: 0; }
.tl-t b { display: block; font-size: 15.5px; line-height: 21px; font-weight: 500; color: var(--text); }
.tl-t small { display: block; font-size: 13px; line-height: 18px; color: var(--text-2); margin-top: 1px; }
.tl-row.locked .tl-t b, .tl-row.timed .tl-t b { color: #8e897e; }
.tl-row.locked .tl-t small, .tl-row.timed .tl-t small { color: #a39d91; }
.tl-row.ms .tl-t b { font-size: 14px; }
.tl-row.current { background: #fff; box-shadow: 0 0 0 1px var(--border), 0 4px 14px rgba(42, 36, 20, .05); }
.tl-row.current .tl-t b { font-weight: 600; }
.tl-row:active { background: var(--surface-2); }
.tl-go { height: 32px; padding: 0 14px; border-radius: 999px; background: var(--ink); color: #fff; font-size: 13.5px; font-weight: 600; display: inline-flex; align-items: center; flex: none; }

/* ---------- Calmer journey, option B: checklist cards ---------- */
.ck { background: #fff; border: 1px solid var(--border); border-radius: 18px; margin-top: 16px; overflow: hidden; }
.ck-h { padding: 16px 16px 10px; }
.ck-bar { height: 4px; margin: 0 16px 8px; border-radius: 4px; background: var(--surface-2); overflow: hidden; }
.ck-bar i { display: block; height: 100%; border-radius: 4px; background: var(--sun-500); }
.ck-row { display: flex; align-items: center; gap: 12px; width: 100%; text-align: left; padding: 12px 14px 12px 16px; border-top: 1px solid var(--border); min-height: 58px; }
.ck-row:active { background: var(--surface-2); }
.ck-box { width: 24px; height: 24px; border-radius: 7px; border: 1.5px solid var(--border-strong); display: grid; place-items: center; color: var(--text-3); flex: none; }
.ck-row.done .ck-box { background: var(--ink); border-color: var(--ink); color: #fff; }
.ck-row.current .ck-box, .ck-row.open .ck-box { border-color: var(--ink); border-width: 2px; }
.ck-row.call .ck-box { border-color: #9dbbdd; background: var(--sky-50); color: var(--sky-700); }
.ck-row.current { background: #fffaf0; }
.ck-t { flex: 1; min-width: 0; }
.ck-t b { display: block; font-size: 15.5px; line-height: 21px; font-weight: 500; }
.ck-t small { display: block; font-size: 13px; line-height: 18px; color: var(--text-2); margin-top: 1px; }
.ck-row.current .ck-t b { font-weight: 600; }
.ck-row.done .ck-t b { color: var(--text-2); }
.ck-row.locked .ck-t b, .ck-row.timed .ck-t b { color: #8e897e; }
.ck-row .chev { color: var(--text-3); }
.ck-note { padding: 12px 16px 14px; border-top: 1px solid var(--border); font-size: 13.5px; line-height: 19px; color: var(--text-2); }
.node.flat { box-shadow: none !important; }
.node.flat::before, .node.flat::after { display: none; }

