/* sources */
.srcs { display: flex; flex-wrap: wrap; gap: 6px; }
.cite { height: 30px; padding: 0 12px; border-radius: 999px; background: #efeadf; color: var(--text); font-size: 12.5px; font-weight: 600; display: inline-flex; align-items: center; transition: background .15s, transform .15s; }
.cite:active { background: #e4dece; transform: scale(.96); }
.citescrim { position: absolute; inset: 0; z-index: 20; }
.citecard { position: absolute; background: #fff; border: 1px solid var(--border); border-radius: 14px; padding: 14px; box-shadow: 0 8px 24px rgba(0, 0, 0, .12); display: flex; flex-direction: column; gap: 4px; animation: pop2 .18s ease both; }
.citecard .ct { font-weight: 600; font-size: 14.5px; line-height: 19px; }
.citecard .cd { font-size: 14px; line-height: 19px; color: var(--text-2); }
.citecard .cl { align-self: flex-start; margin-top: 4px; font-size: 13px; color: var(--text-2); text-decoration: underline; }
@keyframes pop2 { from { opacity: 0; transform: scale(.96); } to { opacity: 1; transform: none; } }
.macts { display: flex; gap: 2px; margin: -4px 0 0 -8px; }
.mact { width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; color: var(--text-3); }
.mact:active, .mact.on { background: rgba(42, 42, 42, .07); color: var(--text); }

/* talk to a person */
.esc { width: 100%; background: #fff; border: 1px solid var(--border); border-radius: 16px; padding: 0 16px; }
.esc .eh { padding: 16px 0 12px; display: flex; flex-direction: column; gap: 2px; }
.esc .eh b { font-size: 16px; line-height: 21px; font-weight: 600; }
.esc .eh span { font-size: 14px; line-height: 20px; color: var(--text-2); }
.erow { display: flex; align-items: center; gap: 12px; padding: 12px 0; width: 100%; text-align: left; border-top: 1px solid var(--border); }
.erow .grow { flex: 1; min-width: 0; }
.erow .t1 { font-weight: 600; font-size: 15px; line-height: 20px; }
.erow .t2 { font-size: 13.5px; line-height: 18px; color: var(--text-2); }
.erow .chev { color: var(--text-3); }
.erow:active { opacity: .6; }

/* follow-ups and check-in replies */
.fups { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; animation: msgin .4s var(--ease) both; }
.fup { padding: 9px 14px; border-radius: 18px; border: 1px solid var(--border-strong); background: #fff; font-size: 14.5px; line-height: 20px; font-weight: 500; text-align: left; transition: transform .16s var(--ease), background .15s; }
.fup:active { transform: scale(.97); background: var(--surface-2); }

/* composer */
.composer { flex: none; position: relative; z-index: 2; padding: 4px 12px calc(8px + var(--safe-b)); }
.composer .box { background: #fff; border: 1px solid var(--border-strong); border-radius: 24px; padding: 6px 8px 8px; box-shadow: 0 6px 20px rgba(42, 36, 20, .07); transition: border-color .2s, box-shadow .2s; }
.composer .box:focus-within { border-color: #bdb5a4; box-shadow: 0 6px 24px rgba(42, 36, 20, .12); }
.composer textarea { display: block; width: 100%; border: 0; outline: 0; background: none; resize: none; font-size: 16px; line-height: 22px; padding: 8px 8px 6px; max-height: 120px; min-height: 36px; }
.composer textarea::placeholder { color: var(--text-3); }
.crow { display: flex; align-items: center; gap: 6px; }
.cbtn2 { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; flex: none; color: var(--text); transition: transform .2s var(--spring), background .2s, color .2s; }
.cbtn2.outline { border: 1px solid var(--border-strong); }
.cbtn2.ghost { color: var(--text-2); }
.cbtn2.ghost.on { background: var(--danger-bg); color: var(--danger); }
.cbtn2.send { background: var(--ink); color: #fff; }
.cbtn2.send[disabled] { background: #d9d3c6; }
.cbtn2:not([disabled]):active { transform: scale(.88); }
.composer .foot { display: block; width: 100%; text-align: center; font-size: 11px; line-height: 15px; color: var(--text-3); margin-top: 7px; }
.cmenu { position: absolute; min-width: 232px; background: #fff; border: 1px solid var(--border); border-radius: 16px; padding: 6px; box-shadow: 0 12px 32px rgba(0, 0, 0, .16); animation: pop2 .18s ease both; transform-origin: 0 100%; }
.cmenu .cmh { font-size: 12px; color: var(--text-3); padding: 8px 10px 4px; }
.cmenu button { display: flex; align-items: center; gap: 10px; width: 100%; padding: 11px 10px; border-radius: 10px; font-size: 15px; font-weight: 500; text-align: left; }
.cmenu button:active { background: var(--surface-2); }
.cmenu .cms { display: block; height: 1px; background: var(--border); margin: 4px 6px; }

/* chats sidebar */
.sidewrap { position: absolute; inset: 0; z-index: 30; }
.sidescrim { position: absolute; inset: 0; background: rgba(28, 24, 16, .4); opacity: 0; transition: opacity .3s ease; }
.side { position: absolute; left: 0; top: 0; bottom: 0; width: min(84%, 330px); background: var(--bg); transform: translate3d(-102%, 0, 0); transition: transform .34s var(--ease); display: flex; flex-direction: column; padding: calc(var(--safe-t) + 6px) 10px calc(10px + var(--safe-b)); box-shadow: 12px 0 40px rgba(42, 36, 20, .14); }
.sidewrap.in .sidescrim { opacity: 1; }
.sidewrap.in .side { transform: none; }
.side-h { display: flex; align-items: center; justify-content: space-between; padding-left: 8px; height: 44px; font-size: 20px; }
.side-h b { font-weight: 600; letter-spacing: -.01em; }
.side-new, .side-about { display: flex; align-items: center; gap: 12px; width: 100%; padding: 13px 12px; border-radius: 14px; font-weight: 600; font-size: 15.5px; text-align: left; }
.side-new { background: #fff; border: 1px solid var(--border); margin-top: 8px; }
.side-new:active, .side-about:active, .side-item:active { background: var(--surface-2); }
.side-list { flex: 1; min-height: 0; overflow-y: auto; margin-top: 14px; scrollbar-width: none; }
.side-k { font-size: 12.5px; color: var(--text-3); padding: 0 12px 6px; }
.side-item { display: block; width: 100%; text-align: left; padding: 10px 12px; border-radius: 12px; }
.side-item.on { background: #efeadf; }
.side-item .t1 { display: block; font-size: 15px; line-height: 20px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.side-item .t2 { display: block; font-size: 12.5px; color: var(--text-3); line-height: 17px; }
.side-empty { color: var(--text-3); font-size: 14px; line-height: 20px; padding: 6px 12px; }
.side-about { font-weight: 500; color: var(--text-2); border-top: 1px solid var(--border); border-radius: 0; margin-top: 6px; }

/* "Meet Sol" sheet */
.ms-art { height: 168px; display: grid; place-items: center; margin: 0 -16px 8px; background: radial-gradient(70% 90% at 50% 10%, rgba(255, 220, 133, .6), rgba(255, 220, 133, 0) 72%); }
.ms-list { margin-top: 18px; display: flex; flex-direction: column; gap: 16px; }
.ms-item { display: flex; gap: 14px; align-items: flex-start; }
.ms-item > .i { color: var(--sun-700); margin-top: 1px; }
.ms-item .t1 { font-weight: 600; font-size: 15.5px; line-height: 20px; }
.ms-item .t2 { color: var(--text-2); font-size: 14.5px; line-height: 21px; margin-top: 2px; }
.ms-fine { text-align: center; font-size: 12.5px; line-height: 18px; color: var(--text-2); margin-top: 12px; }
.ms-link { text-decoration: underline; color: var(--text); font-size: inherit; }
.sheet.nograb .grab { visibility: hidden; height: 8px; }

/* shared with the symptom sheet */
.care {
