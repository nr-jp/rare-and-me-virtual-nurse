/* trace: what Sol checked before answering */
.trace { display: flex; flex-direction: column; width: 100%; }
.thead { display: flex; align-items: center; gap: 8px; padding: 4px 0; font-size: 13.5px; line-height: 18px; color: var(--text-2); text-align: left; }
.tico { width: 20px; height: 20px; display: grid; place-items: center; color: var(--text-3); flex: none; }
.tspin { width: 13px; height: 13px; border-radius: 50%; border: 2px solid var(--sun-300); border-top-color: var(--sun-700); animation: spin .7s linear infinite; display: block; }
.tstep.run .tlab { color: var(--text); }
.tcar { color: var(--text-3); transition: transform .25s var(--ease); }
.tstep.open .tcar { transform: rotate(90deg); }
.tbody { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .3s var(--ease); }
.tstep.open .tbody { grid-template-rows: 1fr; }
.tbody > div { overflow: hidden; }
.tbody p { margin: 2px 0 6px 9px; padding: 2px 0 2px 18px; border-left: 2px solid var(--border-strong); font-size: 13.5px; line-height: 19px; color: var(--text-2)
