.chat-empty { margin: auto 0; text-align: center; padding: 8px 4px 4px; }
.chat-empty h2 { font-size: 28px; line-height: 34px; font-weight: 600; letter-spacing: -.02em; margin-top: 16px; }
.chat-empty p { color: var(--text-2); margin: 8px auto 0; font-size: 15.5px; line-height: 22px; max-width: 320px; }
.sugs { display: flex; flex-direction: column; gap: 8px; margin-top: 22px; text-align: left; }
.sug { display: flex; align-items: center; gap: 12px; padding: 13px 14px 13px 16px; border-radius: 16px; background: #fff; border: 1px solid var(--border); font-size: 15px; line-height: 20px; font-weight: 500; width: 100%; text-align: left; transition: transform .16s var(--ease), background .15s; }
.sug span:first-child { flex: 1; min-width: 0; }
.sug .i { color: var(--text-3); }
.sug:active { transform: scale(.985); background: var(--surface-2); }
